{
  "name": "@auditflow/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/test/frontend-completion-accessibility.test.ts src/test/notification-preferences-ui.test.ts src/test/smoke.test.tsx src/test/task-status-ui.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:runtime": "vitest run src/test/frontend-completion-accessibility.test.ts src/test/notification-preferences-ui.test.ts src/test/smoke.test.tsx src/test/task-status-ui.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.11.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "@playwright/test": "^1.46.1"
  }
}

{
  "name": "@auditflow/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/health.test.ts test/company-service.test.ts test/permissions.test.ts test/tenant-boundary.test.ts test/readiness-calculator.test.ts test/evidence-review-policy.test.ts test/mapping-policy.test.ts test/session-service.test.ts test/cookies.test.ts test/crypto-auth.test.ts test/framework-controls-reconciliation-runtime.test.ts test/evidence-upload-security-runtime.test.ts test/evidence-review-mapping-readiness-runtime.test.ts test/tasks-comments-dashboard-reports-runtime.test.ts test/api-contract-completion-runtime.test.ts test/api-contract-completeness.test.ts test/openapi-contract-v2.1-completion.test.ts test/security-route-contracts.test.ts test/authz-cross-tenant-policy.test.ts test/sensitive-data-exposure.test.ts test/production-gate-policy.test.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "openapi:generate": "tsx src/openapi/generate-openapi.ts",
    "prisma:validate": "prisma validate",
    "ai:eval": "tsx src/modules/ai/evaluation/run-ai-eval.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:boot": "vitest run test/backend-boot-health.test.ts test/health.test.ts test/operational-boot-gate.test.ts",
    "test:auth-rbac": "vitest run test/auth-session-csrf-rbac-runtime.test.ts test/session-service.test.ts test/cookies.test.ts test/permissions.test.ts test/security-route-contracts.test.ts",
    "test:framework-runtime": "vitest run test/framework-controls-reconciliation-runtime.test.ts test/framework-publication.test.ts test/framework-upgrade-reconciliation-policy.test.ts test/readiness-calculator.test.ts",
    "test:evidence-upload-security": "vitest run test/evidence-upload-security-runtime.test.ts test/evidence-upload-policy.test.ts test/upload-finalization-policy.test.ts test/security-scan-policy.test.ts test/storage-reconciliation-policy.test.ts",
    "test:evidence-review-readiness": "vitest run test/evidence-review-mapping-readiness-runtime.test.ts test/evidence-review-policy.test.ts test/mapping-policy.test.ts test/readiness-calculator.test.ts test/readiness-traceability-policy.test.ts",
    "test:core-workflow-runtime": "vitest run test/tasks-comments-dashboard-reports-runtime.test.ts test/task-policy.test.ts test/report-generation-contract.test.ts test/dashboard-readiness-contract.test.ts",
    "test:api-contract-completion": "vitest run test/api-contract-completion-runtime.test.ts test/api-contract-completeness.test.ts test/openapi-contract-v2.1-completion.test.ts",
    "test:security-acceptance": "vitest run test/security-route-contracts.test.ts test/tenant-boundary.test.ts test/authz-cross-tenant-policy.test.ts test/sensitive-data-exposure.test.ts",
    "test:ai-runtime": "vitest run test/ai-evaluation-release-gate.test.ts test/ai-policy.test.ts test/ai-contract.test.ts",
    "test:jobs-notifications-runtime": "vitest run test/notification-delivery-contract.test.ts test/jobs-policy.test.ts test/notifications-policy.test.ts",
    "test:auditor-grants-runtime": "vitest run test/auditor-access-grants-completion.test.ts test/auditor-access-policy.test.ts",
    "test:retention-deletion-runtime": "vitest run test/retention-purge-workflow-policy.test.ts test/retention-policy.test.ts",
    "test:operations-recovery-runtime": "vitest run test/operational-boot-gate.test.ts test/health.test.ts test/backend-boot-health.test.ts",
    "test:production-gate-runtime": "vitest run test/production-nonfunctional-gate-evidence.test.ts test/production-gate-policy.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@prisma/client": "^5.20.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.23.8",
    "@fastify/multipart": "^9.0.2",
    "bullmq": "^5.13.2",
    "ioredis": "^5.4.1",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vitest": "^2.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

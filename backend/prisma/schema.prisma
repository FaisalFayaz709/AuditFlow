  updated_at  DateTime          @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user    User    @relation("CommentAuthor", fields: [user_id], references: [id], onDelete: Restrict)

  @@index([company_id, entity_type, entity_id, archived_at, created_at])
  @@index([user_id, created_at(sort: Desc)])
  @@map("comments")
}

model UploadIntent {

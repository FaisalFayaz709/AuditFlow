model Notification {
  id                  String                         @id @default(cuid())
  company_id          String
  user_id             String
  type                NotificationType
  preference_category NotificationPreferenceCategory @default(WORKFLOW)
  entity_type         String?
  entity_id           String?
  channel             NotificationChannel            @default(EMAIL)
  status              NotificationStatus             @default(PENDING)
  dedup_key           String?
  subject             String
  body                String
  action_url          String?
  sensitive_content   Boolean                        @default(false)
  scheduled_at        DateTime?
  next_attempt_at     DateTime?
  sent_at             DateTime?
  read_at             DateTime?
  attempt_count       Int                            @default(0)
  last_error          String?
  delivery_locked_at  DateTime?
  created_at          DateTime                       @default(now())
  updated_at          DateTime                       @updatedAt

  company    Company                @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user       User                   @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([company_id, user_id, dedup_key])
  @@index([company_id, user_id, status, created_at(sort: Desc)])
  @@index([company_id, status, next_attempt_at])
  @@index([company_id, type, entity_type, entity_id])
  @@map("notifications")
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  notification_id     String
  attempt_no          Int
  provider_message_id String?
  status              NotificationDeliveryStatus @default(PENDING)
  last_error          String?
  attempted_at        DateTime                   @default(now())
  next_attempt_at     DateTime?
  completed_at        DateTime?

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Restrict)

  @@unique([notification_id, attempt_no])
  @@index([notification_id, attempted_at(sort: Desc)])
  @@index([status, next_attempt_at])
  @@map("notification_deliveries")
}

model NotificationPreference {

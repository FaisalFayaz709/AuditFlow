  auditor_member CompanyMember @relation("AuditorAccessGrantAuditorMember", fields: [auditor_member_id], references: [id], onDelete: Restrict)
  granted_by     User          @relation("AuditorAccessGrantGrantedBy", fields: [granted_by_user_id], references: [id], onDelete: Restrict)
  revoked_by     User?         @relation("AuditorAccessGrantRevokedBy", fields: [revoked_by_user_id], references: [id], onDelete: SetNull)


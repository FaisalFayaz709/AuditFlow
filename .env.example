NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://auditflow:auditflow_dev_password@localhost:5432/auditflow_dev?schema=public
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
STRUCTURED_LOG_FORMAT=json
DATABASE_SSL_REQUIRED=false
DATABASE_PITR_ENABLED=false
SECRET_MANAGER_PROVIDER=local
LAST_RESTORE_TEST_STATUS=NOT_RUN
# Pass 03 auth/session settings
SESSION_PEPPER=development_session_pepper_change_before_staging
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=604800
CSRF_TOKEN_SECONDS=43200
PASSWORD_RESET_TOKEN_SECONDS=1800
EMAIL_VERIFICATION_TOKEN_SECONDS=86400

# Pass 25 private object storage adapter. Use local only for development/test.
# Production must use s3, r2, or minio with a private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.auditflow-storage
# STORAGE_DRIVER=s3|r2|minio requires the settings below.
# STORAGE_BUCKET=auditflow-evidence-private
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=replace-me
# STORAGE_SECRET_ACCESS_KEY=replace-me
# STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300
# STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# STORAGE_KMS_KEY_ID=
MAX_UPLOAD_BYTES=26214400
# Pass 26 malware/security scan adapter.
# local/test may use disabled_non_production or fake. staging/production require required + clamav.
SECURITY_SCAN_MODE=disabled_non_production
SECURITY_SCAN_PROVIDER=fake
SECURITY_SCAN_ALLOW_NON_PRODUCTION_BYPASS=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
UPLOAD_INTENT_TTL_SECONDS=3600

# Pass 15 AI integration: mock is local/test only; company setting still controls whether AI is enabled.
AI_PROVIDER=mock
AI_DEFAULT_ENABLED=false
AI_PROMPT_VERSION=auditflow-evidence-analysis-v1
AI_MODEL_NAME=auditflow-mock-v1
AI_MAX_INPUT_CHARS=12000


# Pass 16 background jobs and notifications
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=false
JOB_WORKER_CONCURRENCY=3
JOB_REMOVE_ON_COMPLETE_COUNT=1000
JOB_REMOVE_ON_FAIL_COUNT=1000
NOTIFICATION_EMAIL_PROVIDER=fake
NOTIFICATION_DEFAULT_CHANNEL=EMAIL
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BASE_BACKOFF_SECONDS=60
NOTIFICATION_MAX_BACKOFF_SECONDS=3600
NOTIFICATION_DELIVERY_LOCK_SECONDS=300
EXPIRING_EVIDENCE_THRESHOLD_DAYS=30
TASK_DUE_SOON_DAYS=3


# Pass 19 deployment, observability, backup, and readiness controls
APP_VERSION=0.1.0
RELEASE_ID=local-dev
COMMIT_SHA=local
READINESS_CHECK_DATABASE=true
# Redis readiness is false until jobs are enabled for the environment.
READINESS_CHECK_REDIS=false
# Optional DSNs/URLs are platform-specific and must not contain secrets in logs/screenshots.
OBSERVABILITY_ERROR_TRACKING_DSN=
OBSERVABILITY_UPTIME_CHECK_URL=
BACKUP_POLICY_NAME=portfolio-mvp-best-effort
RESTORE_TEST_REQUIRED_BEFORE_CUSTOMER_DATA=true


# Pass 20 customer evidence gate. Keep blocked until production non-functional gates are signed.
CUSTOMER_EVIDENCE_ENABLED=false
PRODUCTION_GATE_STATUS=BLOCKED
PRODUCTION_GATE_APPROVAL_REFERENCE=

# Pass 36 AI evaluation release gate
AI_RELEASE_GATE_STATUS=BLOCKED
AI_RELEASE_GATE_APPROVAL_REFERENCE=
AI_EVALUATION_CORPUS_VERSION=auditflow-ai-eval-corpus-v1-pass-36
